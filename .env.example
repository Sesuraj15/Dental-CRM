PORT=3000
TZ=Asia/Kolkata
DEFAULT_CC=91
# First-run logins (if empty, random passwords are printed in the console)
OWNER_PASSWORD=
ADMIN_PASSWORD=
# Clinic
SLOTS=09:00,10:00,11:00,12:00,14:00,15:00,16:00,17:00
RECALL_DAYS=180
# Admin + owner WhatsApp numbers that get alerts (comma separated, with country code)
NOTIFY_NUMBERS=
# WhatsApp Cloud API (Meta). Leave WA_TOKEN empty for dry-run mode (messages are only logged)
WA_TOKEN=
WA_PHONE_ID=
WA_VERIFY_TOKEN=change-me
APP_SECRET=
WA_TEMPLATE_LANG=en
WA_LEAD_TEMPLATE=lead_welcome
WA_RECALL_TEMPLATE=recall_checkup
WA_REMINDER_TEMPLATE=appointment_reminder
WA_NOTIFY_TEMPLATE=
# Lead sources
AUTO_ENGAGE=true
META_PAGE_TOKEN=
COST_META=180
GOOGLE_ADS_KEY=
COST_GOOGLE=240
GENERIC_API_KEY=change-me
# Published Google Sheet (File > Share > Publish to web > CSV). Columns: name,phone
SHEET_CSV_URL=
